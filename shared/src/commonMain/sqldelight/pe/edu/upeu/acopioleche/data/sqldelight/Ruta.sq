CREATE TABLE RutaEntity (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    acopiadorId TEXT NOT NULL,
    centroSectorId TEXT NOT NULL,
    fecha TEXT NOT NULL,
    estado TEXT NOT NULL,
    volumenDescargadoLitros REAL,
    fechaHoraCierre TEXT
);

CREATE TABLE ParadaRutaEntity (
    rutaId TEXT NOT NULL,
    orden INTEGER NOT NULL,
    proveedorId TEXT NOT NULL,
    estadoParada TEXT NOT NULL,
    PRIMARY KEY (rutaId, proveedorId)
);

selectRutaDelDia:
SELECT * FROM RutaEntity WHERE acopiadorId = ? AND fecha = ? ORDER BY id DESC LIMIT 1;

selectPorId:
SELECT * FROM RutaEntity WHERE id = ?;

selectRutasPorAcopiadorYFecha:
SELECT * FROM RutaEntity WHERE acopiadorId = ? AND fecha = ?;

eliminarRuta:
DELETE FROM RutaEntity WHERE id = ?;

eliminarParadasDeRuta:
DELETE FROM ParadaRutaEntity WHERE rutaId = ?;

selectTodasRutas:
SELECT * FROM RutaEntity ORDER BY fecha DESC, id DESC;

selectParadasDeRuta:
SELECT * FROM ParadaRutaEntity WHERE rutaId = ? ORDER BY orden ASC;

insertarRuta:
INSERT OR REPLACE INTO RutaEntity(id, nombre, acopiadorId, centroSectorId, fecha, estado, volumenDescargadoLitros, fechaHoraCierre)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertarParada:
INSERT OR REPLACE INTO ParadaRutaEntity(rutaId, orden, proveedorId, estadoParada)
VALUES (?, ?, ?, ?);

actualizarEstadoRuta:
UPDATE RutaEntity SET estado = ?, volumenDescargadoLitros = ?, fechaHoraCierre = ? WHERE id = ?;

contarRutas:
SELECT COUNT(*) FROM RutaEntity;
