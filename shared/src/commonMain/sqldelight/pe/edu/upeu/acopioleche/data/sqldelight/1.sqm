-- Migración v1 -> v2. Reconstruye, como ALTER/CREATE explícitos, los cambios que en su momento
-- se hicieron editando directamente los .sq existentes (columnas de sincronización en
-- ProveedorEntity y la tabla UsuarioEntity para persistir login) sin agregar un archivo .sqm.
-- Eso dejó la versión de esquema calculada (1 + cantidad de archivos .sqm) fija en 1 aunque el
-- esquema real ya había cambiado, y por eso un dispositivo que en un build anterior sí llegó a
-- tener version_code=2 en SQLite no podía abrir un APK que volvía a calcular version=1
-- ("Can't downgrade database from version 2 to 1"). A partir de aquí, todo cambio de esquema
-- debe ir en un nuevo archivo N.sqm (ver docs/modelo-dominio.md) y nunca editando el CREATE
-- TABLE de un .sq ya publicado.

ALTER TABLE ProveedorEntity ADD COLUMN synced INTEGER NOT NULL DEFAULT 0;
ALTER TABLE ProveedorEntity ADD COLUMN pendingAction TEXT;
ALTER TABLE ProveedorEntity ADD COLUMN updatedAt TEXT NOT NULL DEFAULT '';
ALTER TABLE ProveedorEntity ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;

CREATE TABLE IF NOT EXISTS UsuarioEntity (
    id TEXT NOT NULL PRIMARY KEY,
    nombreUsuario TEXT NOT NULL,
    contrasenaHash TEXT NOT NULL,
    contrasenaSal TEXT NOT NULL,
    rol TEXT NOT NULL,
    nombreCompleto TEXT NOT NULL,
    centroAcopioId TEXT,
    intentosFallidos INTEGER NOT NULL,
    ultimoIntentoFallidoEn TEXT
);
